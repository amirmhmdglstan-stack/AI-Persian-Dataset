{
  "config_version": "2.0.0",
  "description": "Persian Dataset V2 reproducible configuration. All large paths are on D: for the user's Windows 11 PC. CLI --workdir/--outdir override these defaults for testing.",
  "seed": "persian-dataset-v2-2026-11-02",
  "repo_root": "D:/GPT/dataset/repo",
  "project_root": "D:/GPT/project",
  "workdir": "D:/GPT/dataset/v2_work",
  "outdir": "D:/GPT/dataset/v2_final",
  "source_metadata": "dataset_v2/sources/source_metadata.json",
  "source_policy": "dataset_v2/configs/source_policy.json",
  "tokenizer_baseline": "dataset_v2/tokenizer/persian-bpe-32k.json",
  "default_profiles": ["A"],
  "doc_separator": "<|endoftext|>",
  "split_ratios": {
    "train": 0.97,
    "validation": 0.02,
    "test": 0.01
  },
  "min_clusters_for_forced_representation": 30,
  "target_char_budget": 480000000,
  "target_char_budget_note": "Soft target (~120M tokens at V1's measured 3.991 chars/token); NOT a mandatory quota. Quality and licensing come first. Full-run token count is measured, not assumed.",
  "domain_targets": {
    "encyclopedia": 0.45,
    "educational": 0.15,
    "news": 0.10,
    "literary": 0.15,
    "dialogue": 0.08,
    "qa": 0.05,
    "mixed_web": 0.00,
    "reference": 0.00,
    "legal": 0.00,
    "speech": 0.00
  },
  "domain_targets_note": "Investigation targets only; caps are applied after quality filtering, never by duplicating or padding documents. Unfilled capacity is reported, not filled with quarantined text.",
  "source_caps": {
    "wikipedia_fa_official_20261001": 0.50,
    "wikipedia_fa_2021_mirror_recovery": 0.10,
    "fawikibooks_20261101": 0.08,
    "fawikisource_20261101": 0.15,
    "fawikinews_20261101": 0.05,
    "common_voice_fa_sentences": 0.04,
    "tatoeba_fa_cc_by": 0.04,
    "ganjoor_classics_pd": 0.10,
    "persian_poetry_ccbysa": 0.10,
    "parsinlu_suite_nc": 0.05
  },
  "normalization": {
    "preserve_latin_technical_terms": true,
    "preserve_persian_digits": true,
    "preserve_zwnj": true,
    "repair_mojibake": true,
    "strip_pii": true,
    "max_removal_ratio": 0.25,
    "max_line_boilerplate_ratio": 0.40,
    "collapse_repeated_punctuation": true
  },
  "language": {
    "min_persian_letter_share_of_letters": 0.65,
    "min_persian_letter_share_of_nonspace": 0.30,
    "max_latin_word_share": 0.35,
    "min_persian_stopword_hits": 1,
    "min_persian_specific_letters": 1,
    "arabic_markers": ["الذی", "هذا", "هذه", "في", "على", "كانت", "التي", "ذلك"],
    "persian_stopwords": ["است", "بود", "شد", "شود", "هستند", "این", "آن", "که", "با", "به", "از", "در", "و", "برای", "من", "ما", "یا", "را", "هم", "نیز", "ولی", "اما", "اگر", "چون", "باید", "می\u200cتوان", "وجود", "دارد", "بوده", "خواهد"]
  },
  "quality_profiles": {
    "encyclopedia": {"min_chars": 250, "min_persian_letters": 100, "min_sentences": 2, "max_avg_sentence_len": 400, "max_short_sentence_ratio": 0.55, "require_sentence_end": true},
    "educational": {"min_chars": 180, "min_persian_letters": 70, "min_sentences": 2, "max_avg_sentence_len": 400, "max_short_sentence_ratio": 0.60, "require_sentence_end": true},
    "news": {"min_chars": 180, "min_persian_letters": 70, "min_sentences": 2, "max_avg_sentence_len": 350, "max_short_sentence_ratio": 0.60, "require_sentence_end": true},
    "literary": {"min_chars": 120, "min_persian_letters": 50, "min_sentences": 1, "max_avg_sentence_len": 1000, "max_short_sentence_ratio": 0.95, "require_sentence_end": false, "max_ngram_repeat_ratio": 0.30},
    "dialogue": {"min_chars": 15, "min_persian_letters": 8, "min_sentences": 1, "max_avg_sentence_len": 250, "max_short_sentence_ratio": 1.0, "require_sentence_end": false, "max_ngram_repeat_ratio": 0.40},
    "qa": {"min_chars": 40, "min_persian_letters": 15, "min_sentences": 1, "max_avg_sentence_len": 300, "max_short_sentence_ratio": 0.85, "require_sentence_end": false},
    "default": {"min_chars": 200, "min_persian_letters": 80, "min_sentences": 2, "max_avg_sentence_len": 400, "max_short_sentence_ratio": 0.60, "require_sentence_end": true}
  },
  "quality_global": {
    "max_chars": 60000,
    "max_latin_letter_share": 0.30,
    "max_digit_share": 0.25,
    "max_punctuation_share": 0.20,
    "max_pipe_share": 0.005,
    "max_repeated_paragraph_ratio": 0.25,
    "max_repeated_sentence_ratio": 0.25,
    "max_ngram_repeat_ratio": 0.15,
    "max_compress_ratio": 6.0,
    "min_quality_score": 0.35,
    "borderline_score_band": [0.45, 0.65]
  },
  "dedup": {
    "num_bins": 32,
    "band_size": 4,
    "shingle_n": 5,
    "max_words": 2000,
    "min_shingles_for_near_dup": 8,
    "similarity_threshold": 0.75,
    "max_candidates_per_band": 200,
    "sqlite_cache_mb": 32,
    "commit_every": 1000
  },
  "shard_bytes": 67108864,
  "checkpoint_every_docs": 5000,
  "log_every_docs": 10000,
  "min_free_gb": 20,
  "max_bytes_per_download_on_agent": 104857600,
  "audit_samples_per_category": 5,
  "audit_excerpt_chars": 400,
  "tokenizer": {
    "baseline_vocab_size": 32000,
    "special_token": "<|endoftext|>",
    "special_token_id": 0,
    "comparison_vocab_sizes": [8000, 16000, 32000],
    "model_embedding_dimensions": [512, 768, 1024]
  }
}
