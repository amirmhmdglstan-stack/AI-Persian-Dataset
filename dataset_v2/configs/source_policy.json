{
  "policy_version": "2.0.0",
  "description": "Enforced data-separation policy for Persian Dataset V2. This is an engineering policy, not legal advice.",
  "profiles": {
    "A": {
      "name": "PERMISSIVE_CORE",
      "default": true,
      "allowed_decisions": ["include"],
      "require_content_rights_verified": true,
      "separate_output_dir": "profile_A",
      "may_train": true,
      "may_redistribute": "yes_if_upstream_conditions_met"
    },
    "B": {
      "name": "RESEARCH_ONLY",
      "default": false,
      "allowed_decisions": ["include_research"],
      "require_content_rights_verified": true,
      "require_non_commercial_documentation": true,
      "separate_output_dir": "profile_B",
      "may_train": true,
      "may_redistribute": "research_only_under_NC_terms",
      "warning": "Never mix PROFILE B documents into PROFILE A files."
    },
    "C": {
      "name": "QUARANTINE",
      "default": false,
      "allowed_decisions": ["quarantine", "exclude"],
      "download": false,
      "extract": false,
      "may_train": false,
      "separate_output_dir": "profile_C_quarantine_manifest_only",
      "warning": "Do not train on these documents until rights, provenance and privacy issues are resolved."
    }
  },
  "global_rules": {
    "default_profiles": ["A"],
    "require_per_document_provenance": true,
    "require_global_deduplication_before_splitting": true,
    "require_cluster_consistent_splits": true,
    "pii_policy": "reject_entire_document_and_record_reason",
    "synthetic_text_policy": "exclude_generated_documents_and_generated_query_columns_from_pretraining",
    "privacy_policy": "no_identifiable_private_conversations_phones_emails_or_private_messages",
    "no_access_control_bypass": true,
    "no_robots_or_paywall_evasion": true,
    "do_not_overwrite_v1": true,
    "v1_root_filenames": ["train.txt", "validation.txt", "README.txt", "README.md", "sources.json", "dataset_statistics.json"],
    "large_outputs_outside_git": true,
    "max_single_git_object_mb": 100,
    "estimated_not_measured_label_required": true
  },
  "license_review_rule": "A public URL, MIT/ODC-BY/CC compilation license, or empty license field is NOT evidence that the underlying text is licensed. Classify as UNVERIFIED and quarantine unless authoritative documentation is found."
}
